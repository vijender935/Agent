# Optional: fixed workspace folder (default = current directory)
# AGENT_WORKSPACE=/path/to/your/project

# Extra allowed roots (colon-separated). Primary workspace stays untouched.
# Example for Termux internal storage:
# AGENT_EXTRA_ROOTS=/sdcard/Download:/sdcard/DCIM:/sdcard/Documents:/sdcard/Pictures
# AGENT_EXTRA_ROOTS=/sdcard/Download

# --- Security (recommended for any public tunnel) ---
# AGENT_API_TOKEN=some-long-random-secret
# REQUIRE_CONFIRMATION=true
# REQUIRE_CONFIRMATION_REMOTE=false

# --- Local Grok agent only ---
# Get a key at https://console.x.ai
# XAI_API_KEY=your_xai_api_key_here
# GROK_MODEL=grok-4.5
# GROK_BASE_URL=https://api.x.ai/v1

# --- Limits / audit ---
# MAX_STEPS=12
# AUDIT_LOG_PATH=.agent_audit.jsonl
